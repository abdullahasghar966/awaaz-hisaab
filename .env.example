# Server
PORT=3000
NODE_ENV=development
DB_PATH=./data/app.db         # on Vercel the default is /tmp/app.db (only /tmp is writable; resets on cold starts)
TIMEZONE=Asia/Karachi
AUTO_REGISTER=true            # unknown numbers become owners of a new business
DEV_ROUTES=true               # /dev/simulate and simulator page (default: on unless production)
DEV_AUDIO_DIR=./samples       # audioPath in /dev/simulate must be inside this dir
ADMIN_TOKEN=change-me         # dev default. Empty disables /api/admin. In production, unset or change-me disables it
WEBHOOK_AWAIT=false           # true = process before responding 200 (default true on Vercel)
LOG_LEVEL=info

# WhatsApp (Meta Cloud API). Blank provider = meta if token+phone id set, else mock
WHATSAPP_PROVIDER=
META_VERIFY_TOKEN=my-verify-token
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# Speech-to-text. Blank provider = openai if key set, else mock.
# STT_PROVIDER=whisper-local: free, self-hosted whisper.cpp server (see README)
#   STT_PROVIDER=whisper-local
#   STT_LOCAL_URL=http://127.0.0.1:8080   # whisper-server --host/--port (run with -t 4 on 8 GB PCs)
STT_PROVIDER=
OPENAI_API_KEY=
STT_MODEL=whisper-1           # or gpt-4o-transcribe
STT_LANGUAGE=                 # blank = auto-detect; e.g. ur
OPENAI_BASE_URL=https://api.openai.com/v1
STT_LOCAL_URL=http://127.0.0.1:8080

# NLP: auto (LLM if key, else rules) | llm | rules | ollama
# ollama = free, self-hosted local model. 8 GB RAM PCs: ollama pull qwen2.5:3b (about 2.5-3 GB RAM while running)
#   very low memory: qwen2.5:1.5b    |    16 GB+ PCs: qwen2.5:7b (about 5-6 GB RAM)
# NLP_PROVIDER=rules uses no model at all (0 extra RAM).
NLP_PROVIDER=auto
ANTHROPIC_API_KEY=
NLP_MODEL=claude-haiku-5-5
NLP_TIMEOUT_MS=15000
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b       # 1.5b = very low memory, 7b = 16 GB+ PCs
OLLAMA_TIMEOUT_MS=60000       # CPU inference is slow; raise if needed
OLLAMA_NUM_CTX=2048           # context window in tokens; prompt + few-shots fit in 2048 (raise to 4096 if you add examples)
OLLAMA_KEEP_ALIVE=10m         # keep the model loaded this long after the last message; 0 = unload at once

# Confirmation step
CONFIRM_AMOUNT_THRESHOLD=50000
CONFIRM_MIN_CONFIDENCE=0.6
CONFIRM_TTL_MINUTES=10
